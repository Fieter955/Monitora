  <diagram id="alur_monitora" name="Alur Penggunaan Monitora">
    <mxGraphModel dx="1422" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2130" pageHeight="1130" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="title" value="&lt;b style=&amp;quot;font-size:26px&amp;quot;&gt;ALUR PENGGUNAAN MONITORA&lt;/b&gt;&lt;br&gt;&lt;span style=&amp;quot;font-size:14px;color:#64748b&amp;quot;&gt;Dari login sampai laporan: siapa melakukan apa, dan service mana yang bekerja&lt;/span&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="20" width="1000" height="70" as="geometry"/></mxCell>
