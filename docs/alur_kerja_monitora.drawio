        <mxCell id="n11" value='&lt;b style="font-size:16px;color:#0f172a"&gt;Lihat dashboard&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px;color:#334155"&gt;Dashboard, Peta, Topologi, Alert, dan Grafana&lt;/span&gt;&lt;br&gt;&lt;i style="font-size:11px;color:#6b7280"&gt;frontend, grafana&lt;/i&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1215" y="125" width="250" height="130" as="geometry"/></mxCell>
