        <mxCell id="n13" value='&lt;b style="font-size:16px;color:#0f172a"&gt;Unduh laporan status&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px;color:#334155"&gt;File CSV untuk bahan evaluasi&lt;/span&gt;&lt;br&gt;&lt;i style="font-size:11px;color:#6b7280"&gt;backend&lt;/i&gt;' style="rounded=1;arcSize=50;whiteSpace=wrap;html=1;fillColor=#e5e7eb;strokeColor=#6b7280;strokeWidth=2;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1810" y="285" width="250" height="110" as="geometry"/></mxCell>
