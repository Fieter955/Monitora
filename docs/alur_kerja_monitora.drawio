        <mxCell id="laneC" value="" style="rounded=0;html=1;fillColor=#fffaf3;strokeColor=#cbd5e1;" vertex="1" parent="1"><mxGeometry x="40" y="670" width="2050" height="200" as="geometry"/></mxCell>
        <mxCell id="stripC" value="Pemantauan &amp;amp; Alert" style="rounded=0;html=1;horizontal=0;fillColor=#fbe0bd;strokeColor=#cbd5e1;fontStyle=1;fontSize=15;fontColor=#1e293b;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="670" width="50" height="200" as="geometry"/></mxCell>
        <mxCell id="laneD" value="" style="rounded=0;html=1;fillColor=#faf6fc;strokeColor=#cbd5e1;" vertex="1" parent="1"><mxGeometry x="40" y="870" width="2050" height="200" as="geometry"/></mxCell>
        <mxCell id="stripD" value="Topologi Jaringan" style="rounded=0;html=1;horizontal=0;fillColor=#e4d6ec;strokeColor=#cbd5e1;fontStyle=1;fontSize=15;fontColor=#1e293b;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="870" width="50" height="200" as="geometry"/></mxCell>
        <mxCell id="n1" value='&lt;b style="font-size:16px;color:#0f172a"&gt;Login ke aplikasi&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px;color:#334155"&gt;Admin buka Monitora dari jaringan kantor&lt;/span&gt;&lt;br&gt;&lt;i style="font-size:11px;color:#6b7280"&gt;frontend&lt;/i&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="115" y="125" width="250" height="130" as="geometry"/></mxCell>
        <mxCell id="bn1" value="1" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3b6fb6;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="100" y="110" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="n2" value='&lt;b style="font-size:16px;color:#0f172a"&gt;Validasi login&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px;color:#334155"&gt;Gateway cek IP kantor, backend cek akun&lt;/span&gt;&lt;br&gt;&lt;i style="font-size:11px;color:#6b7280"&gt;gateway, backend&lt;/i&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="115" y="505" width="250" height="130" as="geometry"/></mxCell>
        <mxCell id="bn2" value="2" style="ellipse;whiteSpace=wrap;html=1;fillColor=#4d8b3a;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="100" y="490" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="n3" value='&lt;b style="font-size:16px;color:#0f172a"&gt;Tambah perangkat&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px;color:#334155"&gt;Isi lokasi, nama, IP, dan jenis perangkat&lt;/span&gt;&lt;br&gt;&lt;i style="font-size:11px;color:#6b7280"&gt;frontend, backend&lt;/i&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="390" y="125" width="250" height="130" as="geometry"/></mxCell>
        <mxCell id="bn3" value="3" style="ellipse;whiteSpace=wrap;html=1;fillColor=#3b6fb6;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="375" y="110" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="n4" value='&lt;b style="font-size:16px;color:#0f172a"&gt;Simpan ke database&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px;color:#334155"&gt;Data perangkat dan lokasi disimpan&lt;/span&gt;&lt;br&gt;&lt;i style="font-size:11px;color:#6b7280"&gt;backend, db&lt;/i&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="390" y="505" width="250" height="130" as="geometry"/></mxCell>
        <mxCell id="bn4" value="4" style="ellipse;whiteSpace=wrap;html=1;fillColor=#4d8b3a;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="375" y="490" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="n5" value='&lt;b style="font-size:16px;color:#0f172a"&gt;Kirim daftar target&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px;color:#334155"&gt;Backend memberi tahu Prometheus apa yang dicek&lt;/span&gt;&lt;br&gt;&lt;i style="font-size:11px;color:#6b7280"&gt;backend&lt;/i&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="665" y="505" width="250" height="130" as="geometry"/></mxCell>
        <mxCell id="bn5" value="5" style="ellipse;whiteSpace=wrap;html=1;fillColor=#4d8b3a;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="650" y="490" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="n6" value='&lt;b style="font-size:16px;color:#0f172a"&gt;Cek tiap 15 detik&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px;color:#334155"&gt;Ping, web, server, dan SNMP lewat exporter&lt;/span&gt;&lt;br&gt;&lt;i style="font-size:11px;color:#6b7280"&gt;prometheus, exporter&lt;/i&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="665" y="705" width="250" height="130" as="geometry"/></mxCell>
        <mxCell id="bn6" value="6" style="ellipse;whiteSpace=wrap;html=1;fillColor=#b87400;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="650" y="690" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="n7" value='&lt;b style="font-size:16px;color:#0f172a"&gt;Cek aturan alert&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px;color:#334155"&gt;Jika melewati batas, alert dibuat&lt;/span&gt;&lt;br&gt;&lt;i style="font-size:11px;color:#6b7280"&gt;prometheus, alertmanager&lt;/i&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;strokeWidth=2;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="940" y="705" width="250" height="130" as="geometry"/></mxCell>
        <mxCell id="bn7" value="7" style="ellipse;whiteSpace=wrap;html=1;fillColor=#b87400;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="925" y="690" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="n8" value='&lt;b style="font-size:16px;color:#0f172a"&gt;Scan kabel &amp;amp; port&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px;color:#334155"&gt;LibreNMS membaca koneksi antar switch&lt;/span&gt;&lt;br&gt;&lt;i style="font-size:11px;color:#6b7280"&gt;librenms, dispatcher&lt;/i&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="390" y="905" width="250" height="130" as="geometry"/></mxCell>
        <mxCell id="bn8" value="8" style="ellipse;whiteSpace=wrap;html=1;fillColor=#7a5190;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="375" y="890" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="n9" value='&lt;b style="font-size:16px;color:#0f172a"&gt;Sinkron topologi&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px;color:#334155"&gt;Hasil scan disalin tiap 60 detik ke database&lt;/span&gt;&lt;br&gt;&lt;i style="font-size:11px;color:#6b7280"&gt;network-worker, db&lt;/i&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;strokeWidth=2;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="665" y="905" width="250" height="130" as="geometry"/></mxCell>
        <mxCell id="bn9" value="9" style="ellipse;whiteSpace=wrap;html=1;fillColor=#7a5190;strokeColor=#ffffff;strokeWidth=2;fontColor=#ffffff;fontStyle=1;fontSize=12;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="650" y="890" width="30" height="30" as="geometry"/></mxCell>
        <mxCell id="n10" value='&lt;b style="font-size:16px;color:#0f172a"&gt;Gabungkan data&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px;color:#334155"&gt;Backend satukan status, alert, dan titik masalah&lt;/span&gt;&lt;br&gt;&lt;i style="font-size:11px;color:#6b7280"&gt;backend&lt;/i&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;strokeWidth=2;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1215" y="505" width="250" height="130" as="geometry"/></mxCell>
