        <mxCell id="stripA" value="Admin / Pimpinan" style="rounded=0;html=1;horizontal=0;fillColor=#c9dcf5;strokeColor=#cbd5e1;fontStyle=1;fontSize=15;fontColor=#1e293b;fontFamily=Segoe UI;" vertex="1" parent="1"><mxGeometry x="40" y="110" width="50" height="360" as="geometry"/></mxCell>
