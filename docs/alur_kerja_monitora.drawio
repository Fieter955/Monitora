        <mxCell id="d1" value='&lt;b style="font-size:16px"&gt;Ada masalah?&lt;/b&gt;' style="rhombus;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;strokeWidth=2;fontFamily=Segoe UI;fontColor=#7a5a00;" vertex="1" parent="1"><mxGeometry x="1490" y="120" width="250" height="140" as="geometry"/></mxCell>
        <mxCell id="n12" value='&lt;b style="font-size:16px;color:#0f172a"&gt;Tim IT perbaiki&lt;/b&gt;&lt;br&gt;&lt;span style="font-size:13px;color:#334155"&gt;Langsung ke titik yang ditunjukkan di peta&lt;/span&gt;' style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;strokeWidth=2;fontFamily=Segoe UI;align=center;verticalAlign=middle;spacing=6;" vertex="1" parent="1"><mxGeometry x="1810" y="125" width="250" height="130" as="geometry"/></mxCell>
