# Application
APP_NAME=Pantau Infrastruktur
APP_ENV=production
SEED_DEMO_DATA=false
APP_SECRET_KEY=replace-with-at-least-32-random-characters
CREDENTIAL_ENCRYPTION_KEY=replace-with-an-independent-32-character-secret
ACCESS_TOKEN_EXPIRE_MINUTES=480
COOKIE_SECURE=false
ALLOWED_HOSTS=localhost,127.0.0.1,backend,gateway

# Initial administrator (created only when the user table is empty)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-this-password
ADMIN_FULL_NAME=Administrator Infrastruktur

# Database
POSTGRES_DB=monitoring
POSTGRES_USER=monitoring
POSTGRES_PASSWORD=replace-database-password
DATABASE_URL=postgresql+psycopg://monitoring:replace-database-password@db:5432/monitoring

# Monitoring
PROMETHEUS_URL=http://prometheus:9090
BLACKBOX_EXPORTER_URL=http://blackbox-exporter:9115
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=replace-grafana-password
PROMETHEUS_RETENTION_TIME=30d
PROMETHEUS_RETENTION_SIZE=8GB
NODE_EXPORTER_ROOTFS_MODE=ro
LIBRENMS_URL=http://librenms:8000
LIBRENMS_API_TOKEN=replace-after-creating-a-read-write-api-token
LIBRENMS_DB_PASSWORD=replace-librenms-database-password
LIBRENMS_DB_ROOT_PASSWORD=replace-librenms-root-password
LIBRENMS_REDIS_PASSWORD=replace-librenms-redis-password
LIBRENMS_ADMIN_PORT=8001
NETWORK_SYNC_INTERVAL_SECONDS=60
NETWORK_STALE_AFTER_SECONDS=180
TZ=Asia/Makassar

# Public routing
PUBLIC_BASE_URL=http://localhost:8080
NEXT_PUBLIC_APP_NAME=Pantau Infrastruktur
